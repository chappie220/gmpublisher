{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "gmpublisher",
	"version": "2.12.2",
	"identifier": "venner.gmpublisher",
	"build": {
		"beforeDevCommand": "node src-tauri/copySharedLibs.js && npm run dev",
		"beforeBuildCommand": "node src-tauri/copySharedLibs.js && npm run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"security": {
			"csp": null
		},
		"windows": [
			{
				"label": "gmpublisher",
				"title": "gmpublisher",
				"width": 800,
				"height": 600,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"dragDropEnabled": false
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": ["msi", "app", "deb", "rpm"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"resources": [],
		"externalBin": [],
		"copyright": "2021 William Venner",
		"category": "DeveloperTool",
		"shortDescription": "Garrys Mod Workshop Publishing Utility",
		"longDescription": "Garrys Mod Workshop Publishing Utility",
		"linux": {
			"deb": {
				"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
				"recommends": ["gstreamer1.0-plugins-good", "xdg-desktop-portal"],
				"desktopTemplate": "linux/gmpublisher.desktop",
				"files": {
					"/usr/lib/gmpublisher/libsteam_api.so": "lib/steam_api/redistributable_bin/linux64/libsteam_api.so",
					"/usr/share/mime/packages/gmpublisher.xml": "linux/gmpublisher-mime.xml",
					"/usr/share/kio/servicemenus/gmpublisher.desktop": "linux/gmpublisher-servicemenu.desktop"
				}
			},
			"rpm": {
				"depends": ["webkit2gtk4.1", "gtk3"],
				"recommends": ["gstreamer1-plugins-good", "xdg-desktop-portal"],
				"desktopTemplate": "linux/gmpublisher.desktop",
				"files": {
					"/usr/lib/gmpublisher/libsteam_api.so": "lib/steam_api/redistributable_bin/linux64/libsteam_api.so",
					"/usr/share/mime/packages/gmpublisher.xml": "linux/gmpublisher-mime.xml",
					"/usr/share/kio/servicemenus/gmpublisher.desktop": "linux/gmpublisher-servicemenu.desktop"
				}
			}
		},
		"windows": {
			"wix": {
				"template": "msi/msi.wxs"
			}
		}
	}
}
